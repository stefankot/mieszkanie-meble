{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["./edytor/src/*"] }
  },
  "include": ["edytor/src/**/*.ts", "edytor/src/**/*.vue", "vite.config.ts"]
}
